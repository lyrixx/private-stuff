# Default configuration, committed: never put secrets in this file.
#
#   APP_ENV=dev   dummy data, default passwords, deploy forbidden (fresh clone, CI, GitHub Pages)
#   APP_ENV=prod  your own data from data/ and your own passwords
#
# To work in prod mode locally (both files are gitignored):
#   .env.local        -> APP_ENV=prod
#   .env.prod.local   -> PASSWORD=..., CFP_PASSWORD=..., etc. (only loaded in prod mode)
#
# Override the mode for a single command: APP_ENV=dev castor build
APP_ENV=dev
PASSWORD=pass
CFP_PASSWORD=pass
CFP_PROJECT_NAME=project
# castor deploy always deploys to this branch of the Pages project (its production branch)
CFP_PRODUCTION_BRANCH=main
FILES_DIRECTORY=data/files

{% import 'macros.html.twig' as ui %}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="robots" content="noindex nofollow">
        <meta name="color-scheme" content="dark">
        <meta name="theme-color" content="#0b1430">
        {% block meta %}{% endblock %}
        <title>{% block title %}{% endblock %}</title>
        <style>{{source('css/styles.css')}}</style>
        {% block site_assets %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Figtree:wght@400;500;600;700;800&display=swap">
        <link rel="manifest" href="./manifest.json">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <script defer>
            const registerServiceWorker = async () => {
                if ("serviceWorker" in navigator) {
                    try {
                        const registration = await navigator.serviceWorker.register('./service-worker.js');
                    } catch (error) {
                        // nothing to do
                    }
                }
            };
            registerServiceWorker();
        </script>
        {% endblock %}
    </head>
    <body>
        <div class="container">
            <nav class="topbar">
                {% if has_back_link ?? true %}
                    <a href="./" class="brand">{{ ui.icon('arrow-left') }}<span class="brand-mark">PS</span>Private Stuff</a>
                {% else %}
                    <span class="brand"><span class="brand-mark">PS</span>Private Stuff</span>
                {% endif %}
            </nav>

            {% if has_hero ?? true %}
                <header class="hero">
                    {% if block('kicker') is defined %}
                        <p class="kicker">{{ block('kicker') }}</p>
                    {% endif %}
                    <h1>{{ block('heading') is defined ? block('heading') : block('title') }}</h1>
                    <p class="subtitle">{% block subtitle %}{% endblock %}</p>
                </header>
            {% endif %}
            {% block container %}{% endblock %}
            <footer class="footer">Take a deep breath. Everything you need is here.</footer>
        </div>
        {% block scripts %}{% endblock %}
    </body>
</html>

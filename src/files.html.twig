{% extends "base.html.twig" %}

{% import 'macros.html.twig' as ui %}

{% block title %}Files{% endblock %}
{% block subtitle %}Important documents to download.{% endblock %}

{% block container %}
    <section class="panel">
        <header class="panel-head">
            <h2 class="panel-title">Documents</h2>
            <span class="panel-ref">{{ files|length }} {{ files|length == 1 ? 'file' : 'files' }}</span>
        </header>
        <ul class="rows">
            {% for file in files %}
                <li>
                    <a download="{{ file.name }}.{{ file.extension }}" href="./upload/{{ file.path }}" class="link-row">
                        <span class="link-row-ref">{{ file.extension|upper }}</span>
                        <span class="link-row-body">
                            <span class="link-row-title">{{ file.name|title }}</span>
                        </span>
                        {{ ui.icon('download') }}
                    </a>
                </li>
            {% else %}
                <li class="empty">No files found.</li>
            {% endfor %}
        </ul>
    </section>
{% endblock %}

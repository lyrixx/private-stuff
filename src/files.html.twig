{% extends "base.html.twig" %}

{% import 'macros.html.twig' as ui %}

{% block title %}Files{% endblock %}
{% block subtitle %}Important documents to download.{% endblock %}

{% block container %}
    <ul class="card list">
        {% for file in files %}
            <li>
                <a download="{{ file.name }}.{{ file.extension }}" href="./upload/{{ file.path }}" class="list-row list-link">
                    <span class="list-icon list-icon-text">{{ file.extension|upper }}</span>
                    <span class="list-body">
                        <span class="list-title">{{ file.name|title }}</span>
                    </span>
                    {{ ui.icon('download') }}
                </a>
            </li>
        {% else %}
            <li class="list-row list-empty">No files found.</li>
        {% endfor %}
    </ul>
{% endblock %}

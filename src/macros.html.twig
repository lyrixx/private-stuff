{# Stroke icons, adapted from Lucide (ISC license) #}
{% macro icon(name) %}
    <svg class="icon icon-{{ name }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {%- if name == 'arrow-left' -%}
            <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
        {%- elseif name == 'chevron-right' -%}
            <path d="m9 18 6-6-6-6"/>
        {%- elseif name == 'download' -%}
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/>
        {%- elseif name == 'file' -%}
            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/>
        {%- elseif name == 'key' -%}
            <path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4"/><path d="m21 2-9.6 9.6"/><circle cx="7.5" cy="15.5" r="5.5"/>
        {%- elseif name == 'lock' -%}
            <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        {%- elseif name == 'lock-open' -%}
            <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/>
        {%- elseif name == 'mail' -%}
            <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        {%- elseif name == 'phone' -%}
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        {%- endif -%}
    </svg>
{% endmacro %}

{# Initials of a name, for the avatars: "John Doe" gives "JD" #}
{% macro initials(name) -%}
    {{ name|split(' ')|filter(word => word is not empty)|slice(0, 2)|map(word => word|first|upper)|join }}
{%- endmacro %}
